DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Better Auth
# String acak minimal 32 karakter (contoh: openssl rand -base64 32)
BETTER_AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"
# URL aplikasi (lokal: http://localhost:3000, produksi: domain asli)
BETTER_AUTH_URL="http://localhost:3000"

# Akun admin pertama, dibuat oleh `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ganti-dengan-password-kuat"
