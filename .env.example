DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Better Auth
# String acak minimal 32 karakter (contoh: openssl rand -base64 32)
BETTER_AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"
# URL publik aplikasi. Juga dipakai sebagai isi QR ({URL}/{uuid}), jadi untuk event WAJIB domain publik
# (mis. https://vote-astro.vercel.app), bukan localhost, supaya QR bisa dibuka HP penonton.
BETTER_AUTH_URL="http://localhost:3000"

# Akun admin pertama, dibuat oleh `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ganti-dengan-password-kuat"
